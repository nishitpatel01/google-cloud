        "sql": "WITH vector_hits AS (\n  SELECT\n    base.entity_id,\n    base.canonical_name,\n    base.entity_type,\n    base.jurisdiction,\n    base.risk_tier,\n    base.exposure_usd,\n    base.data_origin,\n    base.source_license,\n    distance\n  FROM VECTOR_SEARCH(\n    (SELECT * FROM `acc05_enterprise_graphrag.entities` WHERE pack_id = @pack_id AND ARRAY_LENGTH(embedding) > 0),\n    'embedding',\n    (SELECT @query_embedding AS embedding),\n    top_k => 6,\n    distance_type => 'COSINE'\n  )\n),\nlexical_hits AS (\n  SELECT\n    entity_id,\n    canonical_name,\n    entity_type,\n    jurisdiction,\n    risk_tier,\n    exposure_usd,\n    data_origin,\n    source_license,\n    0.05 AS distance\n  FROM `acc05_enterprise_graphrag.entities`\n  WHERE pack_id = @pack_id\n    AND (\n      (LENGTH(canonical_name) >= 3 AND STRPOS(LOWER(@query_text), LOWER(canonical_name)) > 0)\n      OR (\n        LENGTH(REGEXP_REPLACE(LOWER(canonical_name), r'\\s+(corporation|corp|inc|ltd|llc|co|limited|group|holdings)\\.?$', '')) >= 4\n        AND STRPOS(\n          LOWER(@query_text),\n          REGEXP_REPLACE(LOWER(canonical_name), r'\\s+(corporation|corp|inc|ltd|llc|co|limited|group|holdings)\\.?$', '')\n        ) > 0\n      )\n    )\n  LIMIT 6\n)\nSELECT\n  entity_id,\n  canonical_name,\n  entity_type,\n  jurisdiction,\n  risk_tier,\n  exposure_usd,\n  data_origin,\n  source_license,\n  distance\nFROM (\n  SELECT * FROM vector_hits\n  UNION ALL\n  SELECT * FROM lexical_hits\n)\nQUALIFY ROW_NUMBER() OVER (PARTITION BY entity_id ORDER BY distance ASC) = 1\nORDER BY distance ASC\nLIMIT 6",
