# Copy to .env (git-ignored) and fill in your GCP project details for live mode.
# Replay mode (DEMO_MODE=replay) requires zero GCP credentials.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
APP_ENV=demo
BQ_DATASET=acc05_enterprise_graphrag
BQ_LOCATION=US
BQ_RESERVATION_ID=acc05-graphrag-0slot
GCS_BUCKET=your-gcp-project-id-acc05-enterprise-graphrag

# Runtime mode: replay | record | live
DEMO_MODE=replay
REPLAY_SPEED=1.0

# Graph backend: bigquery (Tier-1 Serverless, $0 idle) | spanner (Tier-2 Enterprise)
GRAPH_BACKEND=bigquery
SPANNER_INSTANCE_ID=
SPANNER_DATABASE_ID=acc05-graphrag-db

# Default models (external-customer portable GA defaults; override for Gemini 4 / Claude)
VERTEX_LOCATION=global
VERTEX_MODEL_SYNTHESIS=gemini-2.5-flash
VERTEX_MODEL_JUDGE=gemini-2.5-pro
VERTEX_EMBEDDING_MODEL=gemini-embedding-2

# Optional Guardrails & Auth (provision dedicated $0/mo template via scripts/provision_model_armor.py)
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE_ID=acc05-enterprise-graphrag-guardrail
ENABLE_CLOUD_DLP=false
REQUIRE_IAP_JWT=false
IAP_JWT_AUDIENCE=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_BQ_BYTES_BILLED=5368709120
