# Copy to deploy/cloudrun.env (git-ignored) and fill in your GCP project values.
# Usage:
#   ./scripts/deploy.sh --dry-run
#   ./scripts/deploy.sh --yes

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
APP_ENV=demo

# Resource names follow the portfolio-wide acc05_ / acc05- attribution standard
BQ_DATASET=acc05_enterprise_graphrag
BQ_LOCATION=US
ARTIFACT_REPO=acc05-graphrag
SERVICE_NAME=acc05-graphrag-ui
REPLAY_SERVICE_NAME=acc05-graphrag-replay
RUNTIME_SA_NAME=acc05-graphrag-run
REPLAY_SA_NAME=acc05-graphrag-replay
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE_ID=acc05-enterprise-graphrag-guardrail

# Access control for the live Cloud Run service: 'iap' (recommended) or 'public'
ACCESS_MODE=iap
IAP_MEMBERS=user:you@example.com

# Optional separate public zero-credential Replay service (role-less SA, $0/mo idle)
DEPLOY_REPLAY=true

# Optional Cloud DLP PII scanning on BYO uploads
ENABLE_CLOUD_DLP=false

# Cloud Run Tier-1 Serverless sizing ($0-$3/mo idle)
MIN_INSTANCES=0
MAX_INSTANCES=2
CPU=1
MEMORY=2Gi
TIMEOUT=600
CONCURRENCY=20
