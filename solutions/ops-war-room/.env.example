# Operations & Incident War Room (ACC-04) — Local Configuration Template
# Copy to .env (git-ignored) and set GCP_PROJECT_ID to enable Live Cloud mode.
# Leave GCP_PROJECT_ID blank to run in zero-credential DEMO_MODE=replay.

DEMO_MODE=replay
GCP_PROJECT_ID=
GCP_REGION=us-central1
BQ_LOCATION=US
BQ_DATASET=acc04_ops_war_room
FIRESTORE_DATABASE=acc04-ops-war-room
GCS_BUCKET=
MODEL_ARMOR_TEMPLATE_ID=
MODEL_ARMOR_LOCATION=us-central1
WORKFLOW_LOCATION=us-central1

# Resource attribution labels
GCP_ENV=dev
GCP_TIER=tier1_serverless
GCP_MANAGED_BY=manual

# Optional Cloud IAP & Security controls
REQUIRE_IAP_AUTH=false
IAP_EXPECTED_AUDIENCE=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
RATE_LIMIT_PER_MIN=60
